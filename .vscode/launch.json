    "version": "0.2.0",
    "configurations": [
        {
            "name": "Men Debug",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_men.dart",
            "args": [
                "--flavor",
                "men"
            ]
        },
        {
            "name": "Women Debug",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_women.dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "women"
            ]
        },
        {
            "name": "Women Release",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_women.dart",
            "flutterMode": "release",
            "args": [
                "--flavor",
                "women"
            ]
        }
    ]
}
